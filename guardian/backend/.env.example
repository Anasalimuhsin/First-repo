# PostgreSQL (TLS is required unless DATABASE_SSL=false, for local dev only)
DATABASE_URL=postgres://guardian:password@localhost:5432/guardian
DATABASE_SSL=false

# AES-256-GCM keys for encrypted columns: "<id>:<base64 32 bytes>", newest first.
# Generate: openssl rand -base64 32
GUARDIAN_DATA_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64_KEY

# Optional: enables the Claude second-pass classifier (only for children whose
# parents consented to the "llm_analysis" scope).
ANTHROPIC_API_KEY=
# GUARDIAN_LLM_MODEL=claude-opus-5-5

PORT=3000
