NODE_ENV=development
PORT=3000

# PostgreSQL (TLS is required unless DATABASE_SSL=false, for local dev only)
DATABASE_URL=postgres://guardian:password@localhost:5432/guardian
DATABASE_SSL=false

# Data-encryption keys for encrypted columns: "<id>:<base64 32 bytes>", newest first.
# Generate: openssl rand -base64 32
# Production: use GUARDIAN_DATA_KEYS_KMS (AWS KMS-wrapped keys) or GUARDIAN_DATA_KEYS_FILE instead.
GUARDIAN_DATA_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64_KEY
# GUARDIAN_DATA_KEYS_KMS=k1:<base64 KMS ciphertext blob>
# GUARDIAN_DATA_KEYS_FILE=/run/secrets/guardian_data_keys

# Browser origins allowed to call the API directly (the web dashboard proxies server-side, so usually empty)
CORS_ORIGINS=
# Where OAuth flows return the parent to
WEB_APP_URL=http://localhost:3001
# Number of proxies in front of the API (for correct client IPs in rate limits and audit)
TRUST_PROXY_HOPS=1

# Version of the privacy policy parents must accept
PRIVACY_POLICY_VERSION=2026-10

# Optional: Claude second-pass classifier (only for children whose parents consented to "llm_analysis")
ANTHROPIC_API_KEY=
# GUARDIAN_LLM_MODEL=claude-opus-5-5

# Optional: push notifications through FCM (Expo push tokens work without this)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Optional: Gmail monitoring (Google Cloud OAuth client, "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/oauth/gmail/callback
GMAIL_SYNC_MINUTES=5

# Optional: verifiable parental consent via a Stripe card check (SetupIntent)
STRIPE_SECRET_KEY=

LOG_LEVEL=info
